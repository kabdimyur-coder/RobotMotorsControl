import serial
import time

# Подставь свой порт: /dev/ttyUSB0, /dev/ttyACM0 и т.д.
ser = serial.Serial('/dev/ttyUSB0', 115200, timeout=1)
time.sleep(2)  # дать контроллеру время на старт

def send_command(left_speed, right_speed):
    # Формат команды: "L120R80\n" (пример)
    cmd = f"L{left_speed}R{right_speed}\n"
    ser.write(cmd.encode('ascii'))

# Пример сценария
send_command(120, 120)  # вперёд
time.sleep(3)

send_command(120, 60)   # поворот направо
time.sleep(2)

send_command(0, 0)      # стоп
ser.close()
